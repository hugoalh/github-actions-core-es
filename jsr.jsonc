{
	"$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
	"name": "@hugoalh/github-actions-core",
	"version": "0.8.0",
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./cli": "./cli.ts",
		"./command/file": "./command/file.ts",
		"./command/stdout": "./command/stdout.ts",
		"./annotation": "./annotation.ts",
		"./env": "./env.ts",
		"./input": "./input.ts",
		"./log": "./log.ts",
		"./output": "./output.ts",
		"./problem-matcher": "./problem_matcher.ts",
		"./runner": "./runner.ts",
		"./state": "./state.ts",
		"./summary": "./summary.ts",
		"./utility": "./utility.ts"
	},
	"imports": {
		"https://raw.githubusercontent.com/hugoalh/env-es/v0.4.0/general.ts": "jsr:@hugoalh/env@^0.4.0/general",
		"https://raw.githubusercontent.com/hugoalh/eol-es/v0.5.1/eol.ts": "jsr:@hugoalh/eol@^0.5.1/eol",
		"https://raw.githubusercontent.com/hugoalh/eol-es/v0.5.1/normalize.ts": "jsr:@hugoalh/eol@^0.5.1/normalize",
		"https://raw.githubusercontent.com/hugoalh/is-json-es/v1.0.6/mod.ts": "jsr:@hugoalh/is-json@^1.0.6",
		"https://raw.githubusercontent.com/hugoalh/is-string-singleline-es/v1.0.6/mod.ts": "jsr:@hugoalh/is-string-singleline@^1.0.6"
	},
	"publish": {
		"exclude": [
			"**/*_bench.js",
			"**/*_bench.jsx",
			"**/*_bench.ts",
			"**/*_bench.tsx",
			"**/*_test.js",
			"**/*_test.jsx",
			"**/*_test.ts",
			"**/*_test.tsx",
			"**/*.bench.js",
			"**/*.bench.jsx",
			"**/*.bench.ts",
			"**/*.bench.tsx",
			"**/*.test.js",
			"**/*.test.jsx",
			"**/*.test.ts",
			"**/*.test.tsx",
			"**/bench.js",
			"**/bench.jsx",
			"**/bench.ts",
			"**/bench.tsx",
			"**/test.js",
			"**/test.jsx",
			"**/test.ts",
			"**/test.tsx",
			"_bench/**",
			"_test/**",
			".astro/**",
			".forgejo/**",
			".git/**",
			".github/**",
			".vscode/**",
			"coverage/**",
			"dist/**",
			".*.build.ts",
			".*.lint.ts",
			".codeql.yml",
			".gitattributes",
			".gitignore",
			".markdownlint.yml",
			".yamllint.yml",
			"CITATION.cff",
			"CODE_OF_CONDUCT.md",
			"CONTRIBUTING.md",
			"deno.jsonc",
			"SECURITY.md"
		]
	}
}

{
	"$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
	"name": "@hugoalh/github-actions-core",
	"version": "0.8.0",
	"license": "MIT",
	"exports": {
		".": "./mod.ts",
		"./cli": "./cli.ts",
		"./command/file": "./command/file.ts",
		"./command/stdout": "./command/stdout.ts",
		"./annotation": "./annotation.ts",
		"./env": "./env.ts",
		"./input": "./input.ts",
		"./log": "./log.ts",
		"./output": "./output.ts",
		"./problem-matcher": "./problem_matcher.ts",
		"./runner": "./runner.ts",
		"./state": "./state.ts",
		"./summary": "./summary.ts",
		"./utility": "./utility.ts"
	},
	"imports": {
	},
	"publish": {
		"exclude": [
			"**/*_bench.js",
			"**/*_bench.jsx",
			"**/*_bench.ts",
			"**/*_bench.tsx",
			"**/*_test.js",
			"**/*_test.jsx",
			"**/*_test.ts",
			"**/*_test.tsx",
			"**/*.bench.js",
			"**/*.bench.jsx",
			"**/*.bench.ts",
			"**/*.bench.tsx",
			"**/*.test.js",
			"**/*.test.jsx",
			"**/*.test.ts",
			"**/*.test.tsx",
			"**/bench.js",
			"**/bench.jsx",
			"**/bench.ts",
			"**/bench.tsx",
			"**/test.js",
			"**/test.jsx",
			"**/test.ts",
			"**/test.tsx",
			"_bench/**",
			"_test/**",
			".astro/**",
			".forgejo/**",
			".git/**",
			".github/**",
			".vscode/**",
			"coverage/**",
			"dist/**",
			".*.build.ts",
			".*.lint.ts",
			".codeql.yml",
			".gitattributes",
			".gitignore",
			".markdownlint.yml",
			".yamllint.yml",
			"CITATION.cff",
			"CODE_OF_CONDUCT.md",
			"CONTRIBUTING.md",
			"deno.jsonc",
			"SECURITY.md"
		]
	}
}
